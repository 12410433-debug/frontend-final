# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# Sistem Informasi Manajemen Event dan Pengumuman FILKOM UNKLAB
# Salin file ini menjadi .env lalu sesuaikan nilai konfigurasinya.
# ==============================================================================

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_JSON_SERVER_URL=/json-server
JSON_SERVER_URL=http://localhost:3001

# Backend Server (Express.js)
PORT=5000

# Google Gemini AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP - gunakan Google App Password, bukan password akun utama
SMTP_USER=12410433@student.unklab.ac.id
SMTP_APP_PASSWORD=APP_PASSWORD_BARU
SMTP_FROM="FILKOM Event Management <12410433@student.unklab.ac.id>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
